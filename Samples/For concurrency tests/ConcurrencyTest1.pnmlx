<?xml version="1.0" encoding="UTF-8"?>
<pnml>
   <net id="net1" type="http://www.pnml.org/version-2009/grammar/pnmlcoremodel">
      <name>
         <text>Digital whiteboard: transfer</text>
      </name>
      <page id="n0">
         <place id="start">
            <name>
               <text>start</text>
            </name>
            <initialMarking tokens="1"/>
         </place>
         <place id="p1">
            <name>
               <text>p1</text>
            </name>
         </place>
         <place id="p2">
            <name>
               <text>p2</text>
            </name>
         </place>
         <place id="p3">
            <name>
               <text>p3</text>
            </name>
         </place>
         <place id="p4">
            <name>
               <text>p4</text>
            </name>
         </place>
         <place id="end">
            <name>
               <text>end</text>
            </name>
            <finalMarking tokens="1"/>
         </place>
         <transition id="split">
            <name>
               <text>Split</text>
            </name>
         </transition>
         <transition id="set1" guard="v1_w &gt; 0">
            <name>
               <text>set1</text>
            </name>
         </transition>
         <transition id="set2" guard="v2_w &gt; 0">
            <name>
               <text>set2</text>
            </name>
         </transition>
         <transition id="check" guard="v1_r &lt; v2_r">
            <name>
               <text>check</text>
            </name>
         </transition>
         <transition id="join">
            <name>
               <text>Join</text>
            </name>
         </transition>
         <arc id="a0" source="start" target="split">
            <arctype>
               <text>normal</text>
            </arctype>
         </arc>
         <arc id="a1" source="split" target="p1">
            <arctype>
               <text>normal</text>
            </arctype>
         </arc>
         <arc id="a2" source="p1" target="set1">
            <arctype>
               <text>normal</text>
            </arctype>
         </arc>
         <arc id="a5" source="set1" target="p2">
            <arctype>
               <text>normal</text>
            </arctype>
         </arc>
         <arc id="a6" source="p2" target="set2">
            <arctype>
               <text>normal</text>
            </arctype>
         </arc>
         <arc id="a7" source="set2" target="p3">
            <arctype>
               <text>normal</text>
            </arctype>
         </arc>
         <arc id="a8" source="p3" target="check">
            <arctype>
               <text>normal</text>
            </arctype>
         </arc>
         <arc id="a9" source="check" target="p4">
            <arctype>
               <text>normal</text>
            </arctype>
         </arc>
		 <arc id="a10" source="p4" target="join">
            <arctype>
               <text>normal</text>
            </arctype>
         </arc>
         <arc id="a11" source="join" target="end">
            <arctype>
               <text>normal</text>
            </arctype>
         </arc>
      </page>
      <variables>
      <variable type="Real">
            <name>v1</name>
         </variable>
         <variable type="Real">
            <name>v2</name>
         </variable>
      </variables>
   </net>
</pnml>
