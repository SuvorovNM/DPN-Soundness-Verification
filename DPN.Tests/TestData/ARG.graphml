  <key id="variables" for="graph" attr.name="variables" attr.type="string" />
  <key id="graph_type" for="graph" attr.name="graph_type" attr.type="string" />
  <key id="is_full" for="graph" attr.name="is_full" attr.type="boolean" />
  <graph id="state_space" edgedefault="directed">
    <node id="30">
      <data key="marking">i=1,p0=0,o=0</data>
      <data key="constraint">(a_r == 0.0) &amp;&amp; (b_r == 0.0)</data>
    </node>
    <node id="31">
      <data key="marking">i=0,p0=1,o=0</data>
      <data key="constraint">!((a_r &lt;= 0.0)) &amp;&amp; (b_r == 0.0)</data>
    </node>
    <node id="32">
      <data key="marking">i=0,p0=1,o=0</data>
      <data key="constraint">!((b_r &lt;= a_r)) &amp;&amp; !((a_r &lt;= 0.0))</data>
    </node>
    <node id="33">
      <data key="marking">i=0,p0=0,o=1</data>
      <data key="constraint">!((a_r &lt;= 0.0)) &amp;&amp; (b_r == 0.0)</data>
    </node>
    <node id="34">
      <data key="marking">i=0,p0=0,o=1</data>
      <data key="constraint">!((b_r &lt;= a_r)) &amp;&amp; !((a_r &lt;= 0.0)) &amp;&amp; !((3.0 &lt;= b_r))</data>
    </node>
    <edge source="30" target="31">
      <data key="label">t0</data>
      <data key="is_silent">false</data>
      <data key="base_transition_id">t0</data>
    </edge>
    <edge source="31" target="32">
      <data key="label">t1</data>
      <data key="is_silent">false</data>
      <data key="base_transition_id">t1</data>
    </edge>
    <edge source="31" target="33">
      <data key="label">t2</data>
      <data key="is_silent">false</data>
      <data key="base_transition_id">t2</data>
    </edge>
    <edge source="32" target="32">
      <data key="label">t1</data>
      <data key="is_silent">false</data>
      <data key="base_transition_id">t1</data>
    </edge>
    <edge source="32" target="34">
      <data key="label">t2</data>
      <data key="is_silent">false</data>
      <data key="base_transition_id">t2</data>
    </edge>
  </graph>
  <graph id="variables" edgedefault="undirected">
    <node id="a">
      <data key="variable_id">a</data>
      <data key="data_type">Real</data>
    </node>
    <node id="b">
      <data key="variable_id">b</data>
      <data key="data_type">Real</data>
    </node>
  </graph>
  <graph id="transitions" edgedefault="undirected">
    <node id="t0">
      <data key="label">t0</data>
      <data key="guard">(a_w &gt; 0.0)</data>
      <data key="is_tau">false</data>
      <data key="is_split">false</data>
    </node>
    <node id="t1">
      <data key="label">t1</data>
      <data key="guard">(b_w &gt; a_r)</data>
      <data key="is_tau">false</data>
      <data key="is_split">false</data>
    </node>
    <node id="t2">
      <data key="label">t2</data>
      <data key="guard">(b_r &lt; 3.0)</data>
      <data key="is_tau">false</data>
      <data key="is_split">false</data>
    </node>
  </graph>
  <graph id="metadata" edgedefault="undirected">
    <data key="graph_type">AbstractReachabilityGraph</data>
    <data key="is_full">true</data>
    <data key="final_marking">i=0,p0=0,o=1</data>
  </graph>
