<?xml version="1.0" encoding="utf-8"?>
<graphml>
  <key id="marking" for="node" attr.name="marking" attr.type="string" />
  <key id="constraint" for="node" attr.name="constraint" attr.type="string" />
  <key id="label" for="edge" attr.name="label" attr.type="string" />
  <key id="base_transition_id" for="edge" attr.name="base_transition_id" attr.type="string" />
  <key id="is_silent" for="edge" attr.name="is_silent" attr.type="boolean" />
  <key id="guard" for="node" attr.name="guard" attr.type="string" />
  <key id="is_tau" for="node" attr.name="is_tau" attr.type="boolean" />
  <key id="is_split" for="node" attr.name="is_split" attr.type="boolean" />
  <key id="variable_id" for="node" attr.name="variable_id" attr.type="string" />
  <key id="data_type" for="node" attr.name="data_type" attr.type="string" />
